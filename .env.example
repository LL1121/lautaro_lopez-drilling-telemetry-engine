# Copiar a .env en el VPS (no commitear .env).
# Sprint 1 no usa SQL ni Redis (ADR-003 / NG-09). El estado vive en memoria.
# ./data queda montado en el backend por si aparece journal local; hoy no se escribe.

# mock | openai | groq | anthropic
# Sin provider, sin API key o sin el SDK instalado, el advisor usa el mock determinista.
LLM_PROVIDER=mock

OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales cuando LLM_PROVIDER apunta a un proveedor real.
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

DATA_DIR=/app/data
