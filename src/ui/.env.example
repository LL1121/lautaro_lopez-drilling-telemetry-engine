# Desarrollo local: next dev (puerto 3000) contra uvicorn en el host.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# Producción (imagen Docker, mismo origen detrás de Caddy):
# NEXT_PUBLIC_API_BASE=
# NEXT_PUBLIC_WS_URL=/ws/telemetry
# La base vacía hace que el cliente llame a /api/... relativo.
# El path relativo del WebSocket se resuelve a wss://<host>/ws/telemetry en HTTPS.
